PORT=3000
APP_URL=http://localhost:3000
# Production: HTTPS public URL and a strong password are required.
APP_PASSWORD=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# 32 random bytes encoded as hex. Keep stable to decrypt stored tokens.
TOKEN_ENCRYPTION_KEY=
# Set to a currently supported LinkedIn Marketing API version (YYYYMM).
LINKEDIN_VERSION=
# Organization publishing requires LinkedIn approval for these scopes.
LINKEDIN_SCOPES=openid profile w_member_social
